{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "env": {
        "RUST_LOG": "info"
      },
      "initialization": {
        "cargo": {
          "features": "all",
          "allTargets": true
        },
        "check": {
          "command": "clippy"
        },
        "procMacro": {
          "enable": true
        }
      }
    }
  },
  "permission": {
    "lsp": "allow"
  }
}